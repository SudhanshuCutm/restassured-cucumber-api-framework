{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Update Task Schema",
  "description": "Schema for validating PUT /update-task response",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Task ID"
    },
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "status": {
      "type": "string",
      "description": "Task status"
    },
    "completed": {
      "type": "boolean",
      "description": "Task completion status"
    }
  },
  "required": ["id", "title", "status"],
  "additionalProperties": true
}
