{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Update Post Schema",
  "description": "Schema for validating PUT /posts/{id} response",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Post ID"
    },
    "title": {
      "type": "string",
      "description": "Updated post title"
    },
    "body": {
      "type": "string",
      "description": "Updated post content"
    },
    "userId": {
      "type": "integer",
      "description": "User ID"
    }
  },
  "required": ["id", "title", "body", "userId"],
  "additionalProperties": false
}
